APP_NAME=CiteShield

# Tenant and admin demo keys (safe dev defaults; rotate for shared envs)
TENANT_A_API_KEY=tenant-a-dev-key
TENANT_B_API_KEY=tenant-b-dev-key
SUPERUSER_API_KEY=superuser-dev-key

# Core retrieval and generation defaults
GENERATOR_BACKEND=extractive
GEMINI_API_KEY=__set_if_using_gemini__
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional OpenAI-compatible backend (vLLM, local gateway, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8001/v1
OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3.1-8B-Instruct
OPENAI_COMPATIBLE_API_KEY=__optional_for_local_servers__

# Qdrant local development
QDRANT_HOST=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=documents
QDRANT_API_KEY=__set_only_for_remote_qdrant__

# Optional lifecycle tracking (JSONL fallback still works if unset)
MLFLOW_TRACKING_URI=__optional_http_or_file_uri__

# Local observability stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
